# Yum4Less daily scheduled ingest (container-local cron).
# Runs as root inside the ingest image; logs append to /var/log/yum4less/ingest.log.
# Timezone = container TZ (set TZ=America/New_York or your market TZ in the Custom App env).
# Env vars come from /etc/yum4less/ingest.env (written by entrypoint from Docker environment).
SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
0 3 * * * root . /etc/yum4less/ingest.env && cd /app && /usr/local/bin/npm run ingest:weekly-ads:scheduled >> /var/log/yum4less/ingest.log 2>&1
15 8 * * * root . /etc/yum4less/ingest.env && cd /app && YUM4LESS_MORNING_REPORT=1 /usr/local/bin/npm run morning:report >> /var/log/yum4less/morning.log 2>&1
15 9 * * * root . /etc/yum4less/ingest.env && cd /app && YUM4LESS_MORNING_REPORT=1 /usr/local/bin/npm run morning:deadman >> /var/log/yum4less/morning.log 2>&1
