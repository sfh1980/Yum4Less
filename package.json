{
  "name": "yum4less",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/ensure-snap-context.mjs --quiet --non-fatal && next dev",
    "ensure:snap-context": "node scripts/ensure-snap-context.mjs",
    "dev:clean": "node -e \"try{require('fs').rmSync('.next',{recursive:true,force:true})}catch(_){}\" && next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "node scripts/run-integration-tests.mjs",
    "test:integration:reset": "node scripts/run-integration-tests.mjs --reset",
    "test:all": "npm test && npm run test:integration",
    "probe:kroger-api": "tsx scripts/test-kroger-api-live.mjs",
    "probe:publix-api": "tsx scripts/test-publix-api-live.mjs",
    "probe:kroger-live-scrape": "tsx scripts/test-kroger-live-scrape.mjs",
    "probe:publix-live-scrape": "tsx scripts/test-publix-live-scrape.mjs",
    "probe:walmart-live-scrape": "tsx scripts/test-walmart-live-scrape.mjs",
    "probe:publix-live-ingest": "node scripts/test-publix-live-ingest.mjs",
    "test:e2e": "playwright test",
    "test:e2e:ci": "node scripts/run-e2e-tests.mjs",
    "ingest:weekly-ads": "node scripts/run-weekly-ad-ingest.mjs",
    "ingest:weekly-ads:fixture": "node scripts/run-weekly-ad-ingest.mjs --fixture",
    "sync:provider-prices": "tsx scripts/sync-provider-prices.ts",
    "ingest:map-catalog": "tsx scripts/ingest-map-catalog.ts",
    "ingest:map-catalog:fixture": "tsx scripts/ingest-map-catalog.ts --fixture",
    "ingest:snap-retailers": "tsx scripts/ingest-snap-retailers.ts",
    "ingest:snap-retailers:fixture": "tsx scripts/ingest-snap-retailers.ts --fixture",
    "ingest:weekly-ads:scheduled": "node scripts/run-scheduled-weekly-ad-ingest.mjs",
    "ingest:weekly-ads:scheduled:fixture": "node scripts/run-scheduled-weekly-ad-ingest.mjs --fixture",
    "ingest:weekly-ads:browser": "node scripts/run-weekly-ad-ingest.mjs --browser",
    "ingest:themealdb:from-sales": "node scripts/run-themealdb-import.mjs",
    "setup:local": "node scripts/setup-local.mjs",
    "db:up": "docker compose up -d db",
    "db:migrate": "node scripts/run-db-migrations.mjs",
    "db:probe:migration-ledger": "node scripts/probe-migration-ledger-evidence.mjs",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up -d db",
    "db:logs": "docker compose logs -f db"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "next": "^15.3.2",
    "pg": "^8.22.0",
    "react": "^19.1.0",
    "react-dom": "^19.2.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@playwright/test": "^1.61.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^26.1.1",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.1.5",
    "@vitejs/plugin-react": "^6.0.3",
    "eslint": "^10.6.0",
    "eslint-config-next": "^16.2.10",
    "jsdom": "^29.1.1",
    "playwright": "^1.60.0",
    "tsx": "^4.23.0",
    "typescript": "^7.0.2",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.10"
  }
}
