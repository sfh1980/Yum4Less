{
  "name": "yum4less",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "node scripts/run-integration-tests.mjs",
    "test:integration:reset": "node scripts/run-integration-tests.mjs --reset",
    "test:all": "npm test && npm run test:integration",
    "test:kroger-api": "tsx scripts/test-kroger-api-live.mjs",
    "test:publix-api": "tsx scripts/test-publix-api-live.mjs",
    "test:kroger-live-scrape": "tsx scripts/test-kroger-live-scrape.mjs",
    "test:publix-live-scrape": "tsx scripts/test-publix-live-scrape.mjs",
    "test:walmart-live-scrape": "tsx scripts/test-walmart-live-scrape.mjs",
    "test:publix-live-ingest": "node scripts/test-publix-live-ingest.mjs",
    "test:e2e": "playwright test",
    "test:e2e:ci": "node scripts/run-e2e-tests.mjs",
    "ingest:weekly-ads": "node scripts/run-weekly-ad-ingest.mjs",
    "ingest:weekly-ads:fixture": "node scripts/run-weekly-ad-ingest.mjs --fixture",
    "ingest:weekly-ads:scheduled": "node scripts/run-scheduled-weekly-ad-ingest.mjs",
    "ingest:weekly-ads:scheduled:fixture": "node scripts/run-scheduled-weekly-ad-ingest.mjs --fixture",
    "ingest:weekly-ads:browser": "node scripts/run-weekly-ad-ingest.mjs --browser",
    "setup:local": "node scripts/setup-local.mjs",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up -d db",
    "db:logs": "docker compose logs -f db"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "next": "^15.3.2",
    "pg": "^8.21.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@playwright/test": "^1.60.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^22.15.21",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.1.5",
    "@types/react-dom": "^19.1.5",
    "@vitejs/plugin-react": "^6.0.2",
    "eslint": "^9.27.0",
    "eslint-config-next": "^15.3.2",
    "jsdom": "^29.1.1",
    "playwright": "^1.60.0",
    "tsx": "^4.20.6",
    "typescript": "^5.8.3",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.6"
  }
}
